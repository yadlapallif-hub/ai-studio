# ==============================================================================
# FRANCIS CREATOR STUDIO — Environment Variables Example
# Copy to customer-website/.env.local and admin-website/.env.local for local dev.
# In Vercel, set these in each project's Environment Variables settings.
# NEVER commit real secret values or expose SUPABASE_SERVICE_ROLE_KEY to clients.
# ==============================================================================

# --- Supabase (Required by both Customer Website & Admin Website) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Public Site URLs (Used for Auth redirects, QR verification URLs & cross-links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_SITE_URL=http://localhost:3000

# --- AI Provider Configuration (Server-only; choose one or configure self-hosted Ollama) ---
# Provider is selected in Admin AI Management or falls back to AI_PROVIDER
AI_PROVIDER=ollama
AI_MODEL=llama3.2

# Option 1: Self-hosted or Cloud Ollama
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# Option 2: OpenAI (or any OpenAI-compatible server)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Google Gemini
GEMINI_API_KEY=

# Option 4: Groq (Free-tier fast inference)
GROQ_API_KEY=

# Option 5: OpenRouter
OPENROUTER_API_KEY=

# Option 6: Custom OpenAI-compatible endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# --- Optional Server Background Removal Service (falls back to free on-device ML segmentation) ---
REMOVE_BG_API_KEY=
BG_REMOVAL_ENDPOINT=

# --- Optional Transactional Email Notifications (Resend / SMTP) ---
# When omitted, in-app realtime notifications remain active and Supabase handles auth emails.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=FRANCIS Creator Studio <noreply@yourdomain.com>
